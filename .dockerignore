*.so
*.pyc
*.swp
*.pkl
*.pyo
*.bak
*.mif
*.orig
/Archives
/build
*.7z
out_*/
/nbproject/
/src/
/venv*
.py*venv/
.venv*
.venv-fmt/
\.DS_Store
.Xil
*.str
*.jou
*.egg-info
.ipynb_checkpoints
.vscode/
corr16tests/
docker-data/
.codex
.env
.env.docker
xreport.xml
.vscode
*__pycache__*
fw_test_results/
firmware_tests/fft_of_data
tmp_*

# Docker-only build-context exclusions.
# Firmware bitstreams are tracked package data required at runtime.
!pychfpga/fpga_firmware/bitstreams/*.bit
.git
/docs
/old_scripts
/sim
/tests
/unused
/ice-qc
**/arm_firmware
/.pytest_cache
