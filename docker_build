#!/bin/bash

set -e # stop this script on errors

# Release images are built only from a clean commit that is itself a tag.
if [ -n "$(git status --porcelain)" ]; then
    echo "Working tree is not clean. Commit or stash changes before building a release image."
    exit 1
fi
if ! GIT_VERSION=$(git describe --tags --exact-match 2>/dev/null); then
    echo "HEAD is not a tagged commit ($(git describe --tags --dirty --always))."
    echo "Tag this commit, then run this script again."
    exit 1
fi
echo Version is $GIT_VERSION

# The image contains the bitstreams and CRS ARM firmware, which are git-lfs files.
git lfs pull

# Docker tags cannot contain '+': 2.2.0+crs_ct is pushed as 2.2.0-crs_ct
IMAGE_NAME_TAG="wtlpychfpga/pychfpga:${GIT_VERSION/+/-}"
echo Image name is $IMAGE_NAME_TAG

# Push requires an existing Docker Hub login for this account. Do not store the token here.
DOCKER_CONFIG_JSON="${DOCKER_CONFIG:-$HOME/.docker}/config.json"
if ! grep -q 'index.docker.io' "$DOCKER_CONFIG_JSON" 2>/dev/null; then
    echo "Not logged in to Docker Hub. Run:"
    echo "  docker login -u wtlpychfpga"
    exit 1
fi

export BUILDKIT_PROGRESS=plain # optional, for more verbose output
export DOCKER_BUILDKIT=1
docker build --target deploy -t $IMAGE_NAME_TAG --build-arg PYCHFPGA_VERSION="$GIT_VERSION" .
docker image push $IMAGE_NAME_TAG