# Docker compose settings for crate012_corr16_docker.yaml (see CRATE012_CORR16_DOCKER.md).
# Use with: docker compose --env-file crate012_corr16_docker.env ...
PYCHFPGA_IMAGE=pychfpga:local
PYCHFPGA_DATA_DIR=/storage/crate012/corr16_docker
PYCHFPGA_CONFIG_FILE=./crate012_corr16_docker.yaml
PYCHFPGA_CONFIG_NAME=CRATE012_CORR16
# ARM of slot 8 (SN0531): fpga_master waits until it answers ping
PYCHFPGA_WAIT_HOSTS=10.10.2.7
PYCHFPGA_WAIT_PING_TIMEOUT=1
PYCHFPGA_WAIT_TIMEOUT=
