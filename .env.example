PYCHFPGA_IMAGE=pychfpga:local
PYCHFPGA_DATA_DIR=./docker-data
PYCHFPGA_CONFIG_FILE=./config/docker_example.yaml
PYCHFPGA_CONFIG_NAME=EXAMPLE
PYCHFPGA_WAIT_HOSTS=192.168.0.100
PYCHFPGA_WAIT_PING_TIMEOUT=1
PYCHFPGA_WAIT_TIMEOUT=
# Optional override. By default ./docker_build computes it from git with setuptools-scm.
# PYCHFPGA_VERSION=1.3.4.dev2+ice.co.g3aec81117.d20260327
